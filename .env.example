# NOTE: no quotes around values below. python-dotenv (local runs/pytest)
# strips surrounding quotes automatically, but `docker run --env-file`
# does NOT -- a quoted key becomes a literal '"key"' string in the
# container and every Groq call fails with 401.

# --- LLM ---
# Groq is the primary (free-tier) LLM provider. Get a key at https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here
# llama-3.3-70b-versatile was deprecated by Groq (2026-06-17) and stopped
# working entirely mid-project -- openai/gpt-oss-120b is Groq's own
# recommended replacement. Check https://console.groq.com/docs/deprecations
# if this one stops working too.
GROQ_MODEL=openai/gpt-oss-120b

# Ollama is the offline fallback if Groq is unavailable/rate-limited.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# --- App ---
APP_ENV=development
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- File System tool sandbox ---
# All file reads/writes are restricted to this directory (no arbitrary file access).
FILES_SANDBOX_DIR=./workspace

# --- Web Search: Tavily (optional) ---
# DuckDuckGo (duckduckgo-mcp-server) needs no key and is the
# default/fallback. Set TAVILY_API_KEY to use Tavily instead when it's
# configured -- purpose-built for LLM/agent search, but needs a free
# account at https://tavily.com. Leave blank to run entirely key-free.
TAVILY_API_KEY=
